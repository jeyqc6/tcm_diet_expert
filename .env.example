# Copy to .env and fill in:  cp .env.example .env
# 非 LLM 变量：shell export 仍优先于 .env
# LLM 变量（MODEL_TIER / 各家 API key / provider / model）：.env 优先于 shell
#   改完 .env 后仍需重启 uvicorn（进程启动时只 load 一次）

DIET_EXPERT_PG_DSN=postgresql://user:pass@localhost:5432/diet_expert

# ============================================================================
# VPS / docker compose 前端（构建期变量，见 docker-compose.yml frontend.build.args）
# ============================================================================
# 浏览器里跑的 JS 要请求的 API 根地址。本地 Docker 默认 localhost:8123 即可。
# 部署到公网 VPS 时改成公网地址，然后 docker compose up --build（必须 --build）：
# PUBLIC_API_BASE_URL=http://203.0.113.10:8123
# scripts/vps_deploy.sh 会自动检测公网 IP 并写入这一行。

# ============================================================================
# 时区（backend/mcp_server/tools/query_diet_log.py，D30）
# ============================================================================
# 相对日期("今天"/"昨天")解析用哪个时区，优先级：
#   user_profile.timezone（每个用户自己的，首次引导 §11.2 收集）
#   > DIET_EXPERT_TZ（下面这个，本地开发/测试时的兜底，不用为了跑通就先建一条 user_profile）
#   > 硬编码 Asia/Shanghai
# 不设就是 Asia/Shanghai——**不要**用服务器的系统时区，部署到别的地区的云主机上
# 结果会跟着服务器所在地漂移，这正是这个环境变量存在的原因。
# DIET_EXPERT_TZ=Asia/Shanghai

# ============================================================================
# LLM adapter（backend/llm/adapter.py + backend/llm/providers/）
# ============================================================================
# D19 双档策略 + D29 多 provider：dev/prod 两档可以各自选不同的服务商，
# 不是"选一个 provider 全局用"——比如本地用 Ollama 免费迭代，
# 交付/跑分时切到 Anthropic 或 OpenAI，改这几行环境变量就行，不用改代码。

# dev / prod 两档各自用哪家服务商：openai | anthropic | deepseek | ollama | openrouter
# 不单独配就退到 LLM_PROVIDER；LLM_PROVIDER 也不配就默认 openai。
# LLM_PROVIDER_DEV=ollama
# LLM_PROVIDER_PROD=anthropic
# LLM_PROVIDER=openai

MODEL_TIER=dev

# dev / prod 两档各自用哪个具体模型。
# openai/anthropic 不配这两个的话有内置默认值(见 adapter.py _DEFAULT_MODELS)；
# ⚠️ ollama/openrouter 没有内置默认——ollama 是本地拉了哪个模型因机器而异，
#    openrouter 是模型目录本身就是几十家上游随时在变，两者都必须显式配，
#    不配会直接报错，不会瞎猜一个大概率不对的名字。
# LLM_MODEL_DEV=qwen3:0.6b
# LLM_MODEL_PROD=claude-sonnet-5

# ---- provider=openai（也是 provider=ollama 复用的同一套 OpenAI 兼容客户端）----
# LLM_API_KEY=
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
#   ^ 历史遗留：naive_rag.py/run_baselines.py 目前还是直接读这个变量，
#     没有走 adapter.py；adapter.py 的 dev 档也认这个变量做兼容，
#     但新代码应该用 LLM_MODEL_DEV，不要依赖这条兼容路径。
#
# GMI Cloud uses the OpenAI-compatible provider:
# LLM_PROVIDER=openai
# LLM_API_KEY=your_gmi_api_key
# LLM_BASE_URL=https://api.gmi-serving.com/v1
# LLM_MODEL_DEV=your_gmi_model_id

# ---- provider=anthropic ----
# 去 https://console.anthropic.com 申请，需要账号 + 充值(按量计费，非免费)。
# ANTHROPIC_API_KEY=
# Override the default endpoint for an Anthropic-compatible gateway (for example, MiniMax):
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic

# ---- provider=deepseek（Anthropic-compatible Messages API）----
# 去 https://platform.deepseek.com 申请 API key；SDK 仍是 pip install anthropic。
# LLM_PROVIDER=deepseek
# LLM_PROVIDER_DEV=deepseek
# LLM_PROVIDER_PROD=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# LLM_MODEL_DEV=deepseek-v4-flash
# LLM_MODEL_PROD=deepseek-v4-flash
#   ^ 未识别的模型名会被 DeepSeek 后端映射到 deepseek-v4-flash；
#     claude-haiku/claude-sonnet 前缀也会映射到 flash，claude-opus 映射到 pro。

# ---- provider=ollama ----
# Ollama 不是 pip 装的 Python 包，是本机常驻的服务：
#   1. macOS: `brew install ollama`（或去 ollama.com 下载安装包）
#   2. 常驻服务：`ollama serve`（用 brew 装的一般会自动装成后台服务，不用手动跑）
#   3. 拉一个模型："ollama pull qwen3:0.6b"（或其他模型，模型越大越慢/占内存越多）
#   4. 不需要 API key、不花钱——纯本地跑，前提是你的机器扛得住模型大小
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
#   ^ 随便填一个非空字符串就行，Ollama 不校验这个值，只是 OpenAI SDK 要求非 None

# ---- provider=openrouter ----
# OpenRouter 本身是一层 OpenAI 兼容代理，一个 key 能转发到几十家上游模型
# （OpenAI/Anthropic/Google/开源模型都有），按量计费(部分模型标 :free 免费)。
#   1. 去 https://openrouter.ai/keys 申请 key
#   2. 模型名是 "vendor/model" 这种 slug，去 https://openrouter.ai/models 查，
#      比如 "anthropic/claude-haiku-4.5"、"openai/gpt-4o-mini"、
#      "meta-llama/llama-3.1-8b-instruct:free"——必须配 LLM_MODEL_DEV/PROD，
#      没有内置默认值（原因同上）
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================================================
# Langfuse（backend/observability/，ENGINEERING §6）
# 不会用：先看 docs/LANGFUSE.md（从零到打开一条 trace）。
# ============================================================================
# 不配这两组 key 时 tracing 是 no-op：请求照跑，SSE `done.trace_id` / `X-Trace-Id`
# 仍然生成，只是不上报。测试强制 LANGFUSE_ENABLED=0，不会打到你的项目。
#
# Cloud：https://cloud.langfuse.com 建项目后把 public/secret key 贴这里。
# 自托管：把 LANGFUSE_BASE_URL 指到自己的实例（PRD：可观测数据自托管、上报前脱敏）。
# 不要把 Langfuse 整套栈塞进本仓库的 docker-compose.yml——会打破 §9 的 90s 冷启动。
#
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=dev
#
# 默认不上报用户原文/检索原文/饮食记录（健康数据）。自托管且你信任该实例时才打开：
# LANGFUSE_CAPTURE_IO=1
# LANGFUSE_ENABLED=1

# ============================================================================
# 日志（backend/logging_config.py，ENGINEERING §6.2）
# ============================================================================
# json = 每行一个 JSON 对象（生产 / docker）。text = 本地 uvicorn 人读。
# trace_id 从请求 ContextVar 自动挂上，业务代码不用往 logger.info 里手传。
# LOG_FORMAT=text
# LOG_LEVEL=INFO

# ============================================================================
# 编排层超时（backend/agents/timeouts.py，ENGINEERING §1.1 / §2）
# ============================================================================
# 单次 LLM 调用 20s 在 adapter 里，不在这里。下面两层默认值对齐 §1.1 表格。
# SUBAGENT_TIMEOUT_S=45
# CHAIN_TIMEOUT_S=90
