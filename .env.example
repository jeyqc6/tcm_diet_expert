# =============================================================================
# Setup
# =============================================================================
#   cp .env.example .env
#   Fill in the values below, then restart uvicorn or `docker compose up`.
#
# LLM vars in .env override shell exports. Restart the API process after edits.
#
# MODEL_TIER picks which provider/model pair is active:
#   dev  → LLM_PROVIDER_DEV  + LLM_MODEL_DEV
#   prod → LLM_PROVIDER_PROD + LLM_MODEL_PROD
#
# Providers: openai | anthropic | deepseek | ollama | openrouter
# =============================================================================

# --- Required ---

DIET_EXPERT_PG_DSN=postgresql://user:pass@localhost:5432/diet_expert

MODEL_TIER=dev

# Active tier (example: DeepSeek via Anthropic-compatible API)
LLM_PROVIDER_DEV=deepseek
LLM_MODEL_DEV=deepseek-v4-flash
DEEPSEEK_API_KEY=

# Optional second tier (e.g. a stronger model for eval / delivery)
# LLM_PROVIDER_PROD=deepseek
# LLM_MODEL_PROD=deepseek-v4-flash

# --- Provider credentials (uncomment the block you use) ---

# DeepSeek — https://platform.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic   # default if omitted

# Anthropic — https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=   # optional gateway, e.g. https://api.minimax.io/anthropic

# OpenAI-compatible (OpenAI, GMI Cloud, etc.)
# LLM_PROVIDER_DEV=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_DEV=gpt-4o-mini

# OpenRouter — https://openrouter.ai/keys  (model slug required, e.g. openai/gpt-4o-mini)
# LLM_PROVIDER_DEV=openrouter
# OPENROUTER_API_KEY=
# LLM_MODEL_DEV=openai/gpt-4o-mini

# Ollama (local) — `ollama serve` + `ollama pull <model>`
# LLM_PROVIDER_DEV=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# LLM_MODEL_DEV=qwen3:0.6b

# --- Optional ---

# Relative dates ("today" / "yesterday") when user has no timezone in profile
# DIET_EXPERT_TZ=Asia/Shanghai

# Browser → API URL for Docker frontend build (VPS: set to your public host:8123)
# PUBLIC_API_BASE_URL=http://localhost:8123

# Langfuse tracing (no-op if unset) — see docs/LANGFUSE.md
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LOG_FORMAT=text
# LOG_LEVEL=INFO

# Orchestration timeouts (backend/agents/timeouts.py; defaults 45s / 90s)
# SUBAGENT_TIMEOUT_S=90
# CHAIN_TIMEOUT_S=120

# Preload BGE-M3 on uvicorn startup (and after each --reload). Default on;
# set 0 to skip (faster pytest / CI). First retrieval still lazy-loads if off.
# DIET_EXPERT_WARM_EMBEDDER=1
